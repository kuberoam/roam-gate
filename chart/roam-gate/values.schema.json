{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Roam Gate values",
  "type": "object",
  "definitions": {
    "duration": {
      "description": "A Go duration (30m, 12h, 1h30m) or a number of days (90d).",
      "type": "string",
      "pattern": "^$|^[0-9]+d$|^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
    },
    "quantity": {
      "description": "A Kubernetes quantity, e.g. 2Gi.",
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?([KMGTPE]i?|[mkMGTPE]|e[0-9]+)?$"
    },
    "strings": { "type": "array", "items": { "type": "string" } },
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "issuer": {
      "description": "A cert-manager Issuer (in Gate's namespace) or ClusterIssuer.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["ClusterIssuer", "Issuer"] },
        "name": { "type": "string" }
      }
    }
  },
  "properties": {
    "global": { "type": "object" },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "externalURL": {
      "type": "string",
      "pattern": "^$|^https?://[^/\\s]+(/.*)?$"
    },
    "clusterName": { "type": "string" },
    "admins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "users": { "$ref": "#/definitions/strings" },
        "groups": { "$ref": "#/definitions/strings" }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "ttl": { "$ref": "#/definitions/duration" } }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": { "enum": ["writes", "all"] },
        "retention": { "$ref": "#/definitions/duration" }
      }
    },
    "reconcileInterval": { "$ref": "#/definitions/duration" },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["selfSigned", "secret", "certManager", "none"] },
        "secretName": { "type": "string" },
        "issuer": { "$ref": "#/definitions/issuer" },
        "secretHasCA": { "type": "boolean" },
        "extraDNSNames": { "$ref": "#/definitions/strings" },
        "extraIPs": { "$ref": "#/definitions/strings" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "secret" } }, "required": ["mode"] },
          "then": { "properties": { "secretName": { "minLength": 1 } }, "required": ["secretName"] }
        },
        {
          "if": { "properties": { "mode": { "const": "certManager" } }, "required": ["mode"] },
          "then": { "properties": { "issuer": { "properties": { "name": { "minLength": 1 } }, "required": ["name"] } }, "required": ["issuer"] }
        }
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "loadBalancerSourceRanges": { "$ref": "#/definitions/strings" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "checkClass": { "type": "boolean" },
        "host": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "tlsSecretName": { "type": "string" },
        "issuer": { "$ref": "#/definitions/issuer" }
      },
      "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
      "then": { "properties": { "host": { "minLength": 1 } }, "required": ["host"] }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "$ref": "#/definitions/quantity" },
        "storageClass": { "type": "string" },
        "accessMode": { "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany"] },
        "existingClaim": { "type": "string" },
        "keep": { "type": "boolean" }
      }
    },
    "eks": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "awsAuth": { "type": "boolean" } }
    },
    "resources": { "type": "object" },
    "extraEnv": { "type": "array" },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "podLabels": { "$ref": "#/definitions/stringMap" },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "priorityClassName": { "type": "string" }
  },
  "additionalProperties": false
}
